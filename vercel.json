{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/check-tracking", "schedule": "0 12 * * *" },
    { "path": "/api/cron/kitless-alert", "schedule": "0 13 * * *" },
    { "path": "/api/cron/quiz-nudge", "schedule": "0 14 * * *" },
    { "path": "/api/cron/purchase-pending", "schedule": "0 15 * * *" }
  ]
}
